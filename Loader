--  วิธีเพิ่มเกมใหม่: ใส่บรรทัดในตาราง GAMES ด้านล่าง (รหัสเกม = game.GameId, อ่านจากเกมนั้นด้วย print(game.GameId))
--  token ของแต่ละสคริปต์ = ตัวอักษรยาวๆ ระหว่าง /public/ และ /download ใน URL ดาวน์โหลดของ Junkie
--  หมายเหตุ: ไม่ต้องใส่ service/provider ที่นี่ เพราะหน้าใส่คีย์ (UI Source) จัดการให้แล้ว
-- ══════════════════════════════════════════════════════════════

local GAMES = {
    -- [รหัสเกม (GameId / universe)] = { name = "ชื่อเกม", script_id = "token ของสคริปต์เกมนั้นใน Junkie" }
    [10770933473] = {
        name = "+1 Anime Eyes",
        script_id = "f35d211b44c79af86ca27768a0d52c05ff1aa80d321893fdb997d1c61b0b69d4",
    },
}

-- รองรับเพลซเดี่ยวที่ GameId อ่านไม่ได้/ไม่ตรง (ใส่เฉพาะที่จำเป็น)
local PLACES = {
    [97617452700163] = 10770933473, -- +1 Anime Eyes
}

local function say(text)
    warn("[Vortex Hub] " .. text)
    pcall(function()
        game:GetService("StarterGui"):SetCore("SendNotification", { Title = "Vortex Hub", Text = text, Duration = 6 })
    end)
end

local entry = GAMES[game.GameId] or GAMES[PLACES[game.PlaceId] or 0]
if not entry then
    say("เกมนี้ยังไม่รองรับ (GameId " .. tostring(game.GameId) .. ") / This game is not supported yet")
    return
end

local Junkie = loadstring(game:HttpGet("https://jnkie.com/sdk/library.lua"))()
Junkie.script_id = entry.script_id
Junkie.load_script()
